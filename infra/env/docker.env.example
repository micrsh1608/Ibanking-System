# Copy to infra/env/docker.env and replace these three values.
# Use 16+ characters with upper/lowercase, digits and symbols for SQL Server.
MSSQL_SA_PASSWORD=CHANGE_ME
# Two different random strings, each at least 32 characters.
JWT_SECRET_KEY=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME
# Required real SMTP configuration. No local inbox runs in the main project.
# Sender credentials are separate from each user's recipient email.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=YOUR_PROVIDER_APP_PASSWORD
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=sender@example.com
