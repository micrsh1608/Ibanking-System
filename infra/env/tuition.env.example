# Append these lines to the existing root .env, do not replace the existing .env.
TUITION_DB_NAME=tuition_db
# Reuses existing DB_SERVER and DB_DRIVER from the Account Service.
# For Windows Authentication, omit TUITION_DB_USER / TUITION_DB_PASSWORD.
# For SQL login on a server, set both variables in the private .env.
# TUITION_DB_USER=...
# TUITION_DB_PASSWORD=...
# DB_TRUST_SERVER_CERTIFICATE=no
# JWT_SECRET_KEY must match Account Service, never publish it.
