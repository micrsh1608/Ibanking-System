APP_NAME=TV2 Tuition & OTP Service
DATABASE_URL=sqlite:///./tuition.db

OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5

# Email configuration.
# Leave SMTP_HOST empty to use DEMO mode: OTP is printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@ibanking.local
SMTP_USE_TLS=true
