# Windows development. Keep the existing private .env if one is present.
DB_SERVER=localhost
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_NAME=account_db
PAYMENT_DB_NAME=payment_db
TUITION_DB_NAME=tuition_db
DB_TRUST_SERVER_CERTIFICATE=yes
# Leave these empty for Windows Authentication.
DB_USER=
DB_PASSWORD=
# Generate two independent random values; do not use these placeholders.
JWT_SECRET_KEY=CHANGE_ME
INTERNAL_API_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
# REST integration and recovery worker.
ACCOUNT_SERVICE_URL=http://127.0.0.1:8001
TUITION_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_URL=http://127.0.0.1:8002
PAYMENT_RECOVERY_ENABLED=true
PAYMENT_MAIL_ENABLED=true
# Real SMTP sender credentials; recipient comes from the user's verified profile.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=YOUR_PROVIDER_APP_PASSWORD
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=sender@example.com
