{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Service",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/payments": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Create Payment",
        "operationId": "create_payment_api_v1_payments_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "History",
        "operationId": "history_api_v1_payments_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{payment_id}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Get Payment",
        "operationId": "get_payment_api_v1_payments__payment_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{payment_id}/send-otp": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Send Otp",
        "operationId": "send_otp_api_v1_payments__payment_id__send_otp_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OTPChallengeView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{payment_id}/verify-otp": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Verify Otp",
        "operationId": "verify_otp_api_v1_payments__payment_id__verify_otp_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Payment Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OTPVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OTPVerifiedView"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{payment_id}/process": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Process",
        "operationId": "process_api_v1_payments__payment_id__process_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          },
          "202": {
            "description": "Đang xử lý hoặc đối soát; tra cứu cùng UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          },
          "409": {
            "description": "Chưa xác minh OTP, hoặc giao dịch đã thất bại/được hoàn tiền"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payments/{payment_id}/cancel": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Cancel Draft",
        "operationId": "cancel_draft_api_v1_payments__payment_id__cancel_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentView"
                }
              }
            }
          },
          "409": {
            "description": "Chỉ được hủy giao dịch chưa bắt đầu xử lý"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health/db": {
      "get": {
        "summary": "Database Health",
        "operationId": "database_health_health_db_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OTPChallengeView": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "title": "Challenge Id"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "resend_after_seconds": {
            "type": "integer",
            "title": "Resend After Seconds",
            "default": 60
          },
          "demo_mode": {
            "type": "boolean",
            "title": "Demo Mode",
            "default": false
          },
          "delivery_address": {
            "type": "string",
            "title": "Delivery Address"
          },
          "email_delivery": {
            "type": "string",
            "enum": [
              "smtp",
              "not_configured"
            ],
            "title": "Email Delivery",
            "default": "not_configured"
          }
        },
        "type": "object",
        "required": [
          "challenge_id",
          "expires_at",
          "delivery_address"
        ],
        "title": "OTPChallengeView"
      },
      "OTPVerifiedView": {
        "properties": {
          "payment_id": {
            "type": "string",
            "title": "Payment Id"
          },
          "status": {
            "type": "string",
            "const": "OTP_VERIFIED",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "payment_id",
          "status"
        ],
        "title": "OTPVerifiedView"
      },
      "OTPVerifyRequest": {
        "properties": {
          "challenge_id": {
            "type": "string",
            "format": "uuid",
            "title": "Challenge Id"
          },
          "otp": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Otp"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge_id",
          "otp"
        ],
        "title": "OTPVerifyRequest"
      },
      "PaymentCreate": {
        "properties": {
          "mssv": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Mssv"
          },
          "selection_mode": {
            "type": "string",
            "const": "ALL_UNPAID",
            "title": "Selection Mode",
            "default": "ALL_UNPAID"
          },
          "terms_accepted": {
            "type": "boolean",
            "title": "Terms Accepted"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mssv",
          "terms_accepted"
        ],
        "title": "PaymentCreate"
      },
      "PaymentItemView": {
        "properties": {
          "invoice_id": {
            "type": "integer",
            "title": "Invoice Id"
          },
          "invoice_version": {
            "type": "integer",
            "title": "Invoice Version"
          },
          "semester": {
            "type": "string",
            "title": "Semester"
          },
          "amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount"
          }
        },
        "type": "object",
        "required": [
          "invoice_id",
          "invoice_version",
          "semester",
          "amount"
        ],
        "title": "PaymentItemView"
      },
      "PaymentPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PaymentView"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "PaymentPage"
      },
      "PaymentView": {
        "properties": {
          "payment_id": {
            "type": "string",
            "title": "Payment Id"
          },
          "transaction_code": {
            "type": "string",
            "title": "Transaction Code"
          },
          "payer_user_id": {
            "type": "integer",
            "title": "Payer User Id"
          },
          "account_id": {
            "type": "integer",
            "title": "Account Id"
          },
          "payer_email": {
            "type": "string",
            "title": "Payer Email"
          },
          "email_delivery": {
            "type": "string",
            "enum": [
              "smtp",
              "not_configured"
            ],
            "title": "Email Delivery",
            "default": "not_configured"
          },
          "mssv": {
            "type": "string",
            "title": "Mssv"
          },
          "student_name": {
            "type": "string",
            "title": "Student Name"
          },
          "selection_mode": {
            "type": "string",
            "title": "Selection Mode"
          },
          "total_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Amount"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_OTP",
              "OTP_VERIFIED",
              "PROCESSING",
              "PENDING_RECONCILIATION",
              "SUCCEEDED",
              "FAILED",
              "REFUNDED"
            ],
            "title": "Status"
          },
          "phase": {
            "type": "string",
            "enum": [
              "RESERVE",
              "DEBIT",
              "FINALIZE",
              "CANCEL",
              "DONE"
            ],
            "title": "Phase"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/PaymentItemView"
            },
            "type": "array",
            "title": "Items"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "retry_count": {
            "type": "integer",
            "title": "Retry Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "receipt_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "PENDING",
                  "SENT"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Receipt Status"
          },
          "active_challenge": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OTPChallengeView"
              },
              {
                "type": "null"
              }
            ]
          },
          "terms_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terms Version"
          },
          "terms_accepted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terms Accepted At"
          }
        },
        "type": "object",
        "required": [
          "payment_id",
          "transaction_code",
          "payer_user_id",
          "account_id",
          "payer_email",
          "mssv",
          "student_name",
          "selection_mode",
          "total_amount",
          "status",
          "phase",
          "items",
          "error_message",
          "retry_count",
          "created_at",
          "updated_at",
          "completed_at",
          "receipt_status",
          "active_challenge",
          "terms_version",
          "terms_accepted_at"
        ],
        "title": "PaymentView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}