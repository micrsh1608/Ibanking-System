  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvoiceView": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "semester": {
            "type": "string",
            "title": "Semester"
          },
          "amount_due": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Amount Due"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "semester",
          "amount_due",
          "status",
          "version"
        ],
        "title": "InvoiceView"
      },
      "ReservationSelection": {
        "properties": {
          "invoice_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Invoice Id"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "invoice_id",
          "version"
        ],
        "title": "ReservationSelection"
      },
      "ReservationView": {
        "properties": {
          "payment_id": {
            "type": "string",
            "title": "Payment Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "mssv": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mssv"
          },
          "total_amount": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Amount"
          },
          "invoice_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Invoice Ids"
          }
        },
        "type": "object",
        "required": [
          "payment_id",
          "status",
          "mssv",
          "total_amount",
          "invoice_ids"
        ],
        "title": "ReservationView"
      },
      "ReserveRequest": {
        "properties": {
          "payment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Payment Id"
          },
          "mssv": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "title": "Mssv"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReservationSelection"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Items"
          },
          "expected_total": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Expected Total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "payment_id",
          "mssv",
          "items",
          "expected_total"
        ],
        "title": "ReserveRequest"
      },
      "TuitionView": {
        "properties": {
          "mssv": {
            "type": "string",
            "title": "Mssv"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "total_unpaid": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total Unpaid"
          },
          "invoices": {
            "items": {
              "$ref": "#/components/schemas/InvoiceView"
            },
            "type": "array",
            "title": "Invoices"
          }
        },
        "type": "object",
        "required": [
          "mssv",
          "full_name",
          "total_unpaid",
          "invoices"
        ],
        "title": "TuitionView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Key"
      }
    }
  }
}